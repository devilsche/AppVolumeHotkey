<Window x:Class="AppVolumeHotkey.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AppVolumeHotkey.Localization"
        xmlns:ui="clr-namespace:AppVolumeHotkey.UI"
        Title="AppVolumeHotkey"
        Width="1320" Height="760" MinWidth="960" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <DataTemplate x:Key="WrapContent">
            <AccessText Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="ContentTemplate" Value="{StaticResource WrapContent}" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="ContentTemplate" Value="{StaticResource WrapContent}" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="AccessText">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Screenreader: Name direkt am Listeneintrag -->
        <Style x:Key="A11yItem" TargetType="ListBoxItem" BasedOn="{StaticResource RoundedListItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>
        <Style x:Key="GroupItem" TargetType="ListBoxItem" BasedOn="{StaticResource RoundedListItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        </Style>
        <ControlTemplate x:Key="SplitterTemplate" TargetType="GridSplitter">
            <Border Background="Transparent">
                <Rectangle x:Name="Line" Width="2" RadiusX="1" RadiusY="1" Margin="0,8" Opacity="0.35"
                           Fill="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Line" Property="Opacity" Value="1" />
                    <Setter TargetName="Line" Property="Fill" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Line" Property="Opacity" Value="1" />
                    <Setter TargetName="Line" Property="Width" Value="4" />
                    <Setter TargetName="Line" Property="Fill" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="GroupsColumn" Width="240" MinWidth="180" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="400" />
            <ColumnDefinition x:Name="RunningGapColumn" Width="12" />
            <ColumnDefinition x:Name="RunningColumn" Width="320" MinWidth="220" />
        </Grid.ColumnDefinitions>

        <!-- Kopfzeile -->
        <DockPanel Grid.ColumnSpan="5" Margin="0,0,0,16" LastChildFill="False">
            <Image DockPanel.Dock="Left" Source="/Assets/app-96.png" Width="28" Height="28" Margin="0,0,10,0"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="" />
            <TextBlock DockPanel.Dock="Left" Text="AppVolumeHotkey" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Left" x:Name="VersionLabel" Margin="10,4,0,0" VerticalAlignment="Center" Style="{StaticResource Caption}" />
            <Border x:Name="PausedHint" DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                    CornerRadius="10" Padding="10,2" Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                <TextBlock Text="{l:T Main_HotkeysPaused}" FontWeight="SemiBold" />
            </Border>
            <Button DockPanel.Dock="Right" x:Name="SettingsButton" Click="Settings_Click" MinHeight="32" Padding="12,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,8,0" />
                    <AccessText Text="{l:T Main_Settings}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Click="About_Click" MinHeight="32" Padding="12,4" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,8,0" />
                    <AccessText Text="{l:T Main_About}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </DockPanel>

        <GridSplitter Grid.Row="1" Grid.Column="1" Width="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE" Template="{StaticResource SplitterTemplate}"
                      DragCompleted="Splitter_DragCompleted" KeyboardIncrement="20" Focusable="True" IsTabStop="True"
                      AutomationProperties.Name="{l:T Main_SplitterLeft}" ToolTip="{l:T Main_SplitterTip}" />
        <GridSplitter x:Name="RunningSplitter" Grid.Row="1" Grid.Column="3" Width="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Cursor="SizeWE" Template="{StaticResource SplitterTemplate}"
                      DragCompleted="Splitter_DragCompleted" KeyboardIncrement="20" Focusable="True" IsTabStop="True"
                      AutomationProperties.Name="{l:T Main_SplitterRight}" ToolTip="{l:T Main_SplitterTip}" />

        <!-- Spalte 1: Gruppen -->
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Panel}">
            <DockPanel>
                <Label DockPanel.Dock="Top" Target="{Binding ElementName=GroupList}" Padding="0" Margin="0,0,0,8">
                    <AccessText Text="{l:T Main_Groups}" Style="{StaticResource SectionHeading}" />
                </Label>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button Click="NewGroup_Click" HorizontalAlignment="Stretch" MinHeight="32" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                            <AccessText Text="{l:T Main_NewGroup}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <UniformGrid Columns="2">
                        <Button x:Name="RenameGroupButton" Content="{l:T Main_Rename}" Click="RenameGroup_Click" MinHeight="32" Padding="6,4"
                                HorizontalAlignment="Stretch" Margin="0,0,4,0" ToolTip="{l:T Main_RenameTip}" />
                        <Button x:Name="DeleteGroupButton" Content="{l:T Main_Delete}" Click="DeleteGroup_Click" MinHeight="32" Padding="6,4"
                                HorizontalAlignment="Stretch" Margin="4,0,0,0" ToolTip="{l:T Main_DeleteGroupTip}" />
                    </UniformGrid>
                </StackPanel>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="GroupList" Style="{StaticResource PlainList}" DisplayMemberPath="Name" SelectionChanged="GroupList_SelectionChanged"
                             ItemContainerStyle="{StaticResource GroupItem}"
                             KeyDown="GroupList_KeyDown" AutomationProperties.Name="{l:T Main_GroupsName}" />
                    <StackPanel Grid.Row="1" Margin="0,16,0,0">
                        <TextBlock Text="{l:T Main_Features}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListBox x:Name="FeatureList" Style="{StaticResource PlainList}" ItemContainerStyle="{StaticResource RoundedListItem}" SelectionChanged="FeatureList_SelectionChanged" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{l:T Main_Features}">
                            <ListBoxItem x:Name="MicFeatureItem">
                                <DockPanel>
                                    <TextBlock x:Name="MicFeatureIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE720;" Margin="0,0,10,0" />
                                    <TextBlock x:Name="MicFeatureState" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:T Main_FeatureMic}" VerticalAlignment="Center" />
                                </DockPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="DuckingFeatureItem">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE995;" Margin="0,0,10,0" />
                                    <TextBlock x:Name="DuckingFeatureState" DockPanel.Dock="Right" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                    <TextBlock Text="{l:T Main_FeatureDucking}" VerticalAlignment="Center" />
                                </DockPanel>
                            </ListBoxItem>
                        </ListBox>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Spalte 2: gewählte Gruppe -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}">
            <Grid>
                <!-- Mikrofon -->
                <ScrollViewer x:Name="MicPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="{l:T Mic_Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{l:T Mic_Intro}" Style="{StaticResource Caption}" Margin="0,0,0,16" />

                        <Border x:Name="MicStateCard" CornerRadius="8" Padding="16,12" BorderThickness="1" Margin="0,0,0,24"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                            <DockPanel>
                                <Button x:Name="MicToggleButton" DockPanel.Dock="Right" Click="MicToggle_Click" MinHeight="32" Padding="12,4" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <AccessText x:Name="MicToggleText" />
                                </Button>
                                <TextBlock x:Name="MicStateIcon" Style="{StaticResource Icon}" FontSize="22" Margin="0,0,12,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="MicStateText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock x:Name="MicNoHotkeyHint" Text="{l:T Mic_NoHotkeyHint}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Label Content="{l:T Mic_Hotkey}" Target="{Binding ElementName=MicHotkeyBox}" Padding="0,0,0,4" />
                        <ui:HotkeyBox x:Name="MicHotkeyBox" MaxWidth="360" HorizontalAlignment="Left" MinWidth="240"
                                      AutomationProperties.Name="{l:T Mic_Title}" />
                        <TextBlock Text="{l:T Profile_HotkeyHint}" Style="{StaticResource Caption}" Margin="0,4,0,0" />
                        <TextBlock x:Name="MicHotkeyError" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Visibility="Collapsed"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                        <CheckBox x:Name="MicPassThroughBox" Content="{l:T Mic_PassThrough}" Margin="0,8,0,0" Click="MicOption_Changed" />

                        <TextBlock Text="{l:T Mic_Mode}" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,8" />
                        <RadioButton x:Name="MicModeToggle" GroupName="MicMode" Content="{l:T Mic_ModeToggle}" Margin="0,0,0,8" Click="MicOption_Changed" />
                        <RadioButton x:Name="MicModeHold" GroupName="MicMode" Content="{l:T Mic_ModeHold}" Margin="0,0,0,8" Click="MicOption_Changed" />
                        <RadioButton x:Name="MicModePtt" GroupName="MicMode" Content="{l:T Mic_ModePtt}" Click="MicOption_Changed" />

                        <TextBlock Text="{l:T Mic_Scope}" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,8" />
                        <RadioButton x:Name="MicScopeAll" GroupName="MicScope" Content="{l:T Mic_ScopeAll}" Margin="0,0,0,8" Click="MicOption_Changed" />
                        <RadioButton x:Name="MicScopeDefault" GroupName="MicScope" Content="{l:T Mic_ScopeDefault}" Click="MicOption_Changed" />

                        <TextBlock Text="{l:T Mic_Feedback}" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,8" />
                        <CheckBox x:Name="MicOverlayBox" Content="{l:T Mic_ShowOverlay}" Margin="0,0,0,8" Click="MicOption_Changed" />
                        <CheckBox x:Name="MicSoundBox" Content="{l:T Mic_PlaySound}" Margin="0,0,0,8" Click="MicOption_Changed" />
                        <StackPanel Orientation="Horizontal" Margin="28,0,0,8">
                            <Label Content="{l:T Mic_SoundLabel}" Target="{Binding ElementName=MicSoundCombo}" Padding="0,0,8,0" VerticalAlignment="Center" />
                            <ComboBox x:Name="MicSoundCombo" MinWidth="160" SelectionChanged="MicSound_Changed" AutomationProperties.Name="{l:T Profile_SoundA11y}" />
                        </StackPanel>
                        <CheckBox x:Name="MicStatusBox" Content="{l:T Mic_ShowInStatus}" Margin="0,0,0,8" Click="MicOption_Changed" />
                        <CheckBox x:Name="MicUnmuteExitBox" Content="{l:T Mic_UnmuteOnExit}" Click="MicOption_Changed" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Ducking -->
                <ScrollViewer x:Name="DuckingPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="{l:T Main_FeatureDucking}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="{l:T Ducking_Intro}" Style="{StaticResource Caption}" Margin="0,0,0,16" />
                        <CheckBox x:Name="DuckingOnBox" Content="{l:T Ducking_Enabled}" Margin="0,0,0,16" Click="DuckingOn_Click" />

                        <Label Content="{l:T Ducking_ToggleHotkey}" Target="{Binding ElementName=DuckingHotkeyBox}" Padding="0,0,0,4" />
                        <ui:HotkeyBox x:Name="DuckingHotkeyBox" MaxWidth="360" HorizontalAlignment="Left" MinWidth="240"
                                      AutomationProperties.Name="{l:T Ducking_ToggleHotkey}" />
                        <TextBlock x:Name="DuckingHotkeyError" Margin="0,4,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Visibility="Collapsed"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

                        <DockPanel Margin="0,24,0,8" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{l:T Ducking_Rules}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button x:Name="AddRuleButton" DockPanel.Dock="Right" Click="AddRule_Click" MinHeight="32" Padding="12,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                                    <AccessText Text="{l:T Ducking_AddRule}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                        <TextBlock x:Name="DuckingEmptyHint" Style="{StaticResource Caption}" FontSize="14" Margin="0,8,0,0" />
                        <StackPanel x:Name="RuleCards" />
                    </StackPanel>
                </ScrollViewer>

                <TextBlock x:Name="NoGroupHint" Text="{l:T Main_NoGroup}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                <DockPanel x:Name="GroupPanel" Visibility="Collapsed">
                    <TextBlock x:Name="GroupTitle" DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

                    <!-- Apps -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{l:T Main_Apps}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ItemsControl x:Name="AppChips" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" CornerRadius="16" Padding="12,2,2,2" Margin="0,0,8,8"
                                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding AccessibleName}">
                                            <TextBlock Text="{Binding Exe}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding VolumeText}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                       Typography.NumeralAlignment="Tabular" Style="{StaticResource Caption}" />
                                            <Button Click="RemoveApp_Click" Tag="{Binding Exe}" Margin="6,0,0,0"
                                                    Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="0"
                                                    AutomationProperties.Name="{Binding RemoveName}" ToolTip="{Binding RemoveName}">
                                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="DropZone" AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                                BorderThickness="2" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                BorderBrush="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" Background="Transparent">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0" />
                                <TextBlock Text="{l:T Main_DropHint}" />
                            </StackPanel>
                        </Border>
                        <Button x:Name="AddExeButton" Content="{l:T Main_AddExe}" Click="AddExe_Click" HorizontalAlignment="Left" MinHeight="32" Padding="12,4" />
                    </StackPanel>

                    <!-- Profile -->
                    <DockPanel Margin="0,24,0,0">
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                            <Label DockPanel.Dock="Left" Target="{Binding ElementName=ProfileList}" Padding="0" VerticalAlignment="Center">
                                <AccessText Text="{l:T Main_Profiles}" Style="{StaticResource SectionHeading}" />
                            </Label>
                            <Button DockPanel.Dock="Right" Click="NewProfile_Click" MinHeight="32" Padding="12,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Margin="0,0,8,0" />
                                    <AccessText Text="{l:T Main_NewProfile}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                        <Grid>
                            <ListBox x:Name="ProfileList" Style="{StaticResource PlainList}" HorizontalContentAlignment="Stretch" KeyDown="ProfileList_KeyDown"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource A11yItem}"
                                     MouseDoubleClick="ProfileList_MouseDoubleClick" AutomationProperties.Name="{l:T Main_ProfilesName}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderThickness="1" CornerRadius="4" Padding="8,3" MinWidth="80" VerticalAlignment="Center"
                                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                                <TextBlock Text="{Binding HotkeyText}" HorizontalAlignment="Center" FontWeight="SemiBold"
                                                           Typography.NumeralAlignment="Tabular" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <Border HorizontalAlignment="Left" Margin="0,4,0,0" CornerRadius="9" Padding="8,1"
                                                        Background="{StaticResource GoldBrush}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource OnGoldBrush}" FontSize="12"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="12" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Click="EditProfile_Click" Tag="{Binding}" Width="36" Height="32" MinWidth="32" MinHeight="32" Padding="0" Margin="0,0,8,0"
                                                        AutomationProperties.Name="{Binding EditName}" ToolTip="{Binding EditName}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" />
                                                </Button>
                                                <Button Click="DeleteProfile_Click" Tag="{Binding}" Width="36" Height="32" MinWidth="32" MinHeight="32" Padding="0"
                                                        AutomationProperties.Name="{Binding DeleteName}" ToolTip="{Binding DeleteName}">
                                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="NoProfilesHint" Text="{l:T Main_NoProfiles}" Style="{StaticResource Caption}" FontSize="14"
                                       Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                    </DockPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Spalte 3: laufende Apps -->
        <Border x:Name="RunningPanel" Grid.Row="1" Grid.Column="4" Style="{StaticResource Panel}">
            <DockPanel>
                <Label DockPanel.Dock="Top" Target="{Binding ElementName=RunningList}" Padding="0" Margin="0,0,0,4">
                    <AccessText Text="{l:T Main_Running}" Style="{StaticResource SectionHeading}" />
                </Label>
                <TextBlock DockPanel.Dock="Top" Text="{l:T Main_RunningHint}" Style="{StaticResource Caption}" Margin="0,0,0,12" />
                <Button DockPanel.Dock="Bottom" x:Name="AddRunningButton" Content="{l:T Main_AddToGroup}" Click="AddRunning_Click"
                        HorizontalAlignment="Stretch" MinHeight="32" Margin="0,12,0,0" />
                <Grid>
                    <ListBox x:Name="RunningList" Style="{StaticResource PlainList}" AutomationProperties.Name="{l:T Main_RunningName}" ItemContainerStyle="{StaticResource A11yItem}"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="RunningList_SelectionChanged"
                             PreviewMouseLeftButtonDown="RunningList_PreviewMouseLeftButtonDown" PreviewMouseMove="RunningList_PreviewMouseMove"
                             MouseDoubleClick="RunningList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Image x:Name="AppIcon" Grid.RowSpan="2" Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding VolumeText}" Style="{StaticResource Caption}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Exe, Mode=OneWay}" /><Run Text="{Binding InGroupSuffix, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                    <!-- Balken immer volle Spaltenbreite, Füllung = Prozentwert (ohne Animation) -->
                                    <Grid x:Name="Bar" Grid.Row="2" Grid.ColumnSpan="3" Height="4" Margin="0,6,0,0" ClipToBounds="True">
                                        <Border CornerRadius="2" Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Opacity="0.5" />
                                        <Border CornerRadius="2" Background="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                                RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding VolumeFraction, Mode=OneWay}" ScaleY="1" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <!-- Bereits in der Gruppe: nur Symbol und Balken abschwächen, Text bleibt lesbar -->
                                    <DataTrigger Binding="{Binding IsInGroup}" Value="True">
                                        <Setter TargetName="AppIcon" Property="Opacity" Value="0.5" />
                                        <Setter TargetName="Bar" Property="Opacity" Value="0.5" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoRunningHint" Text="{l:T Main_NoRunning}" Style="{StaticResource Caption}" FontSize="14"
                               Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               IsHitTestVisible="False" Visibility="Collapsed" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
