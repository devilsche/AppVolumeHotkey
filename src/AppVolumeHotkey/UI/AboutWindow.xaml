<Window x:Class="AppVolumeHotkey.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AppVolumeHotkey.Localization"
        Title="{l:T About_Title}"
        Width="680" Height="760" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Knopfzeile bleibt immer sichtbar -->
        <Border DockPanel.Dock="Bottom" Padding="24,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{l:T About_OpenData}" Click="OpenDataDir_Click" MinHeight="32" Padding="12,4" Margin="0,0,8,0" />
                <Button Content="{l:T Common_Close}" IsCancel="True" IsDefault="True" Click="Close_Click" MinWidth="100" MinHeight="32" />
            </StackPanel>
        </Border>

        <!-- Gesamter Inhalt scrollt; das Lizenzfeld hat eine feste, gut lesbare Höhe -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/app-96.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,16,0" AutomationProperties.Name="" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AppVolumeHotkey" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Text="{l:T About_Tagline}" />
                <TextBlock x:Name="CopyrightText" Margin="0,12,0,0" />
                <TextBlock Text="{l:T About_License}" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0">
                    <Hyperlink x:Name="RepoLink" RequestNavigate="Link_RequestNavigate">
                        <Run x:Name="RepoLinkText" />
                    </Hyperlink>
                </TextBlock>

                <TextBlock Text="{l:T About_Privacy}" Style="{StaticResource SectionHeading}" />
                <TextBlock TextWrapping="Wrap" Text="{l:T About_PrivacyText}" />

                <TextBlock Text="{l:T About_Liability}" Style="{StaticResource SectionHeading}" />
                <TextBlock TextWrapping="Wrap" Text="{l:T About_LiabilityText}" />

                <TextBlock Text="{l:T About_Tech}" Style="{StaticResource SectionHeading}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="{l:T About_TechText}" />
                <TextBox x:Name="NoticesBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Height="240" FontSize="12" AutomationProperties.Name="{l:T About_NoticesA11y}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
