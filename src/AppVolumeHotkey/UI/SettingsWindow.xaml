<Window x:Class="AppVolumeHotkey.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AppVolumeHotkey.Localization"
        Title="{l:T Settings_Title}"
        Width="840" Height="600" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Lange Beschriftungen umbrechen statt abschneiden (Fluent-Stil bleibt erhalten) -->
        <DataTemplate x:Key="WrapContent">
            <AccessText Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="ContentTemplate" Value="{StaticResource WrapContent}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="PageHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,24,0,12" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
            <Setter Property="Padding" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Knopfzeile bleibt immer sichtbar -->
        <Border DockPanel.Dock="Bottom" Padding="24,16" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{l:T Common_Save}" IsDefault="True" Click="Save_Click" MinWidth="100" MinHeight="32" Margin="0,0,8,0" />
                    <Button Content="{l:T Common_Cancel}" IsCancel="True" MinWidth="100" MinHeight="32" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"
                           Visibility="Collapsed" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
            </DockPanel>
        </Border>

        <!-- Bereiche links -->
        <Border DockPanel.Dock="Left" Width="220" Padding="12,24,12,12" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <ListBox x:Name="NavList" SelectionChanged="NavList_SelectionChanged" BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="{l:T Settings_NavA11y}">
                <ListBoxItem AutomationProperties.Name="{l:T Settings_NavGeneral}" Padding="10,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,12,0" />
                        <TextBlock Text="{l:T Settings_NavGeneral}" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="{l:T Settings_NavOverlay}" Padding="10,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" Margin="0,0,12,0" />
                        <TextBlock Text="{l:T Settings_NavOverlay}" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem AutomationProperties.Name="{l:T Settings_NavStatus}" Padding="10,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Margin="0,0,12,0" />
                        <TextBlock Text="{l:T Settings_NavStatus}" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </Border>

        <Grid>
            <!-- Allgemein -->
            <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="32,24,32,24">
                    <TextBlock Text="{l:T Settings_NavGeneral}" Style="{StaticResource PageHeading}" />

                    <Label Content="{l:T Settings_Language}" Target="{Binding ElementName=LanguageBox}" Style="{StaticResource FieldLabel}" Margin="0,16,0,0" />
                    <ComboBox x:Name="LanguageBox" MinWidth="240" MaxWidth="360" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.Name="{l:T Settings_LanguageA11y}" />

                    <TextBlock Text="{l:T Settings_Start}" Style="{StaticResource SectionHeading}" />
                    <CheckBox x:Name="StartWithWindowsBox" Content="{l:T Settings_StartWithWindows}" />
                    <CheckBox x:Name="StartMinimizedBox" Content="{l:T Settings_StartMinimized}" />
                    <CheckBox x:Name="MinimizeToTrayBox" Content="{l:T Settings_MinimizeToTray}" />
                    <CheckBox x:Name="RunAsAdminBox" Content="{l:T Settings_RunAsAdmin}" Margin="0,0,0,4" />
                    <TextBlock x:Name="RunAsAdminHint" Text="{l:T Settings_RunAsAdminHint}" Style="{StaticResource Caption}" Margin="28,0,0,0" />

                    <TextBlock Text="{l:T Settings_Transition}" Style="{StaticResource SectionHeading}" />
                    <Label Content="{l:T Settings_Fade}" Target="{Binding ElementName=FadeBox}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="FadeBox" MinWidth="240" MaxWidth="360" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.Name="{l:T Settings_FadeA11y}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Overlay -->
            <ScrollViewer x:Name="OverlayPage" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
                <StackPanel Margin="32,24,32,24">
                    <TextBlock Text="{l:T Settings_NavOverlay}" Style="{StaticResource PageHeading}" />
                    <TextBlock Text="{l:T Settings_OverlayHint}" Style="{StaticResource Caption}" Margin="0,0,0,24" />

                    <Label Content="{l:T Settings_Position}" Target="{Binding ElementName=CornerBox}" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CornerBox" MinWidth="240" MaxWidth="360" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.Name="{l:T Settings_PositionA11y}" />
                    <Label Content="{l:T Settings_Size}" Target="{Binding ElementName=SizeBox}" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="SizeBox" MinWidth="240" MaxWidth="360" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.Name="{l:T Settings_SizeA11y}" />
                    <Label Content="{l:T Settings_Duration}" Target="{Binding ElementName=DurationBox}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="DurationBox" MinWidth="240" MaxWidth="360" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.Name="{l:T Settings_DurationA11y}" />

                    <Button Content="{l:T Settings_TestOverlay}" Click="TestOverlay_Click" HorizontalAlignment="Left" MinHeight="32" Padding="12,4" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>

            <!-- Statusanzeige -->
            <ScrollViewer x:Name="StatusPage" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="Collapsed">
                <StackPanel Margin="32,24,32,24">
                    <TextBlock Text="{l:T Settings_NavStatus}" Style="{StaticResource PageHeading}" />
                    <TextBlock Text="{l:T Settings_StatusHint}" Style="{StaticResource Caption}" Margin="0,0,0,24" />

                    <CheckBox x:Name="StatusOnBox" Content="{l:T Settings_StatusOn}" Margin="0,0,0,24" />
                    <Label Content="{l:T Settings_StatusStyle}" Target="{Binding ElementName=StatusStyleBox}" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="StatusStyleBox" MinWidth="240" MaxWidth="360" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.Name="{l:T Settings_StatusStyleA11y}" />
                    <Label Content="{l:T Settings_StatusCorner}" Target="{Binding ElementName=StatusCornerBox}" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="StatusCornerBox" MinWidth="240" MaxWidth="360" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.Name="{l:T Settings_StatusCornerA11y}" />
                    <Label Content="{l:T Settings_StatusOpacity}" Target="{Binding ElementName=StatusOpacityBox}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="StatusOpacityBox" MinWidth="240" MaxWidth="360" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.Name="{l:T Settings_StatusOpacityA11y}" />

                    <CheckBox x:Name="TrayBadgeBox" Content="{l:T Settings_TrayBadge}" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
