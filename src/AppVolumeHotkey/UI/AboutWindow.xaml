<Window x:Class="AppVolumeHotkey.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AppVolumeHotkey.Localization"
        Title="{l:T About_Title}"
        Width="600" Height="760" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/app-96.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0" AutomationProperties.Name="" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AppVolumeHotkey" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Opacity="0.8" />
                </StackPanel>
            </StackPanel>
            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                       Text="{l:T About_Tagline}" />
            <TextBlock x:Name="CopyrightText" Margin="0,10,0,0" />
            <TextBlock Text="{l:T About_License}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0">
                <Hyperlink x:Name="RepoLink" RequestNavigate="Link_RequestNavigate">
                    <Run x:Name="RepoLinkText" />
                </Hyperlink>
            </TextBlock>

            <TextBlock Text="{l:T About_Privacy}" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock TextWrapping="Wrap"
                       Text="{l:T About_PrivacyText}" />

            <TextBlock Text="{l:T About_Liability}" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock TextWrapping="Wrap"
                       Text="{l:T About_LiabilityText}" />

            <TextBlock Text="{l:T About_Tech}" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,6"
                       Text="{l:T About_TechText}" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{l:T About_OpenData}" Click="OpenDataDir_Click" MinHeight="32" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="{l:T Common_Close}" IsCancel="True" IsDefault="True" Click="Close_Click" MinWidth="100" MinHeight="32" />
        </StackPanel>

        <TextBox x:Name="NoticesBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="11" AutomationProperties.Name="{l:T About_NoticesA11y}" />
    </DockPanel>
</Window>
