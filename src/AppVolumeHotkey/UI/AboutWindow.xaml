<Window x:Class="AppVolumeHotkey.UI.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Über AppVolumeHotkey"
        Width="600" Height="760" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Assets/app-96.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,14,0" AutomationProperties.Name="" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AppVolumeHotkey" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Opacity="0.8" />
                </StackPanel>
            </StackPanel>
            <TextBlock Margin="0,14,0,0" TextWrapping="Wrap"
                       Text="Lautstärke von App-Gruppen per globalem Hotkey umschalten – z. B. Discord beim Zocken leiser und wieder lauter." />
            <TextBlock x:Name="CopyrightText" Margin="0,10,0,0" />
            <TextBlock Text="Lizenz: MIT – freie Nutzung, Änderung und Weitergabe, ohne Gewähr." Margin="0,4,0,0" TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0">
                <Hyperlink x:Name="RepoLink" RequestNavigate="Link_RequestNavigate">
                    <Run x:Name="RepoLinkText" />
                </Hyperlink>
            </TextBlock>

            <TextBlock Text="Datenschutz" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock TextWrapping="Wrap"
                       Text="Die App sammelt keine Daten und sendet nichts ins Internet. Einstellungen und ein technisches Diagnose-Log (ohne Eingaben) werden nur lokal in %APPDATA%\AppVolumeHotkey gespeichert. Tastatur und Maus werden nur auf die eingestellten Hotkeys geprüft; Eingaben werden weder gespeichert noch weitergegeben." />

            <TextBlock Text="Haftung" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock TextWrapping="Wrap"
                       Text="Die Software wird ohne Gewähr bereitgestellt (MIT-Lizenz). Lautstärken werden über die Audio-Schnittstelle von Windows geändert – dieselbe, die auch der Lautstärkemixer nutzt. Andere Programme werden dabei weder verändert noch ausgelesen." />

            <TextBlock Text="Technik" FontWeight="SemiBold" Margin="0,16,0,4" />
            <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,6"
                       Text="Keine Bibliotheken Dritter. Audio-Zugriff und Infobereich-Symbol sind direkt gegen Windows programmiert. Enthalten ist nur die .NET-Laufzeitumgebung von Microsoft (MIT-Lizenz):" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="_Datenordner öffnen" Click="OpenDataDir_Click" MinHeight="32" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="_Schließen" IsCancel="True" IsDefault="True" Click="Close_Click" MinWidth="100" MinHeight="32" />
        </StackPanel>

        <TextBox x:Name="NoticesBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="11" AutomationProperties.Name="Lizenzen der Komponenten Dritter" />
    </DockPanel>
</Window>
