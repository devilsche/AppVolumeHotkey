<Window x:Class="AppVolumeHotkey.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AppVolumeHotkey.Localization"
        Title="AppVolumeHotkey"
        Width="1320" Height="760" MinWidth="960" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app.ico">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="GroupsColumn" Width="240" MinWidth="170" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition x:Name="RunningColumn" Width="320" MinWidth="200" />
        </Grid.ColumnDefinitions>

        <!-- Kopfzeile -->
        <DockPanel Grid.ColumnSpan="5" Margin="0,0,0,12" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="AppVolumeHotkey" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Left" x:Name="VersionLabel" Margin="10,6,0,0" VerticalAlignment="Center" Opacity="0.7" />
            <TextBlock x:Name="PausedHint" DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center"
                       Text="{l:T Main_HotkeysPaused}" FontWeight="SemiBold" Visibility="Collapsed" />
            <Button DockPanel.Dock="Right" x:Name="SettingsButton" Content="{l:T Main_Settings}" Click="Settings_Click" MinHeight="32" Padding="12,4" />
            <Button DockPanel.Dock="Right" Content="{l:T Main_About}" Click="About_Click" MinHeight="32" Padding="12,4" Margin="0,0,8,0" />
        </DockPanel>

        <!-- Spalte 1: Gruppen -->
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Background="Transparent" Cursor="SizeWE"
                      DragCompleted="Splitter_DragCompleted" KeyboardIncrement="20" Focusable="True" IsTabStop="True"
                      AutomationProperties.Name="{l:T Main_SplitterLeft}" ToolTip="{l:T Main_SplitterTip}">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Rectangle x:Name="Line" Width="2" RadiusX="1" RadiusY="1" Margin="0,8" Opacity="0.35"
                                   Fill="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                            <Setter TargetName="Line" Property="Width" Value="4" />
                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>
        <GridSplitter Grid.Row="1" Grid.Column="3" Width="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Background="Transparent" Cursor="SizeWE"
                      DragCompleted="Splitter_DragCompleted" KeyboardIncrement="20" Focusable="True" IsTabStop="True"
                      AutomationProperties.Name="{l:T Main_SplitterRight}" ToolTip="{l:T Main_SplitterTip}">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="Transparent">
                        <Rectangle x:Name="Line" Width="2" RadiusX="1" RadiusY="1" Margin="0,8" Opacity="0.35"
                                   Fill="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                            <Setter TargetName="Line" Property="Width" Value="4" />
                            <Setter TargetName="Line" Property="Fill" Value="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>
        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Panel}">
            <DockPanel>
                <Label DockPanel.Dock="Top" Target="{Binding ElementName=GroupList}" Padding="0" Margin="0,0,0,8">
                    <AccessText Text="{l:T Main_Groups}" FontSize="16" FontWeight="SemiBold" />
                </Label>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Button Content="{l:T Main_NewGroup}" Click="NewGroup_Click" HorizontalAlignment="Stretch" MinHeight="32" Margin="0,0,0,6" />
                    <UniformGrid Columns="2">
                        <Button x:Name="RenameGroupButton" Content="{l:T Main_Rename}" Click="RenameGroup_Click" MinHeight="32" Margin="0,0,3,0"
                                ToolTip="{l:T Main_RenameTip}" />
                        <Button x:Name="DeleteGroupButton" Content="{l:T Main_Delete}" Click="DeleteGroup_Click" MinHeight="32" Margin="3,0,0,0"
                                ToolTip="{l:T Main_DeleteGroupTip}" />
                    </UniformGrid>
                </StackPanel>
                <ListBox x:Name="GroupList" DisplayMemberPath="Name" SelectionChanged="GroupList_SelectionChanged"
                         KeyDown="GroupList_KeyDown" AutomationProperties.Name="{l:T Main_GroupsName}" />
            </DockPanel>
        </Border>

        <!-- Spalte 2: gewählte Gruppe -->
        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Panel}">
            <Grid>
                <TextBlock x:Name="NoGroupHint" Text="{l:T Main_NoGroup}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" />
                <DockPanel x:Name="GroupPanel" Visibility="Collapsed">
                    <TextBlock x:Name="GroupTitle" DockPanel.Dock="Top" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />

                    <!-- Apps -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{l:T Main_Apps}" Style="{StaticResource SectionHeading}" />
                        <ItemsControl x:Name="AppChips" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" CornerRadius="14" Padding="10,2,2,2" Margin="0,0,6,6"
                                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="{Binding AccessibleName}">
                                            <TextBlock Text="{Binding Exe}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding VolumeText}" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.75"
                                                       FontFamily="Consolas" />
                                            <Button Content="✕" Click="RemoveApp_Click" Tag="{Binding Exe}" Margin="6,0,0,0"
                                                    MinWidth="28" MinHeight="28" Padding="0"
                                                    AutomationProperties.Name="{Binding RemoveName}"
                                                    ToolTip="{Binding RemoveName}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border x:Name="DropZone" AllowDrop="True" Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave"
                                BorderThickness="2" CornerRadius="8" Padding="10" Margin="0,2,0,8"
                                BorderBrush="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" Background="Transparent">
                            <TextBlock Text="{l:T Main_DropHint}" HorizontalAlignment="Center" />
                        </Border>
                        <Button x:Name="AddExeButton" Content="{l:T Main_AddExe}" Click="AddExe_Click" HorizontalAlignment="Left" MinHeight="32" Padding="12,4" />
                    </StackPanel>

                    <!-- Profile -->
                    <DockPanel Margin="0,20,0,0">
                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                            <Label DockPanel.Dock="Left" Target="{Binding ElementName=ProfileList}" Padding="0" VerticalAlignment="Center">
                                <AccessText Text="{l:T Main_Profiles}" FontSize="16" FontWeight="SemiBold" />
                            </Label>
                            <Button DockPanel.Dock="Right" Content="{l:T Main_NewProfile}" Click="NewProfile_Click" MinHeight="32" Padding="12,4" />
                        </DockPanel>
                        <ListBox x:Name="ProfileList" HorizontalContentAlignment="Stretch" KeyDown="ProfileList_KeyDown"
                                 MouseDoubleClick="ProfileList_MouseDoubleClick" AutomationProperties.Name="{l:T Main_ProfilesName}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4" AutomationProperties.Name="{Binding AccessibleName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderThickness="1" CornerRadius="4" Padding="6,2" MinWidth="90" VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                            <TextBlock Text="{Binding HotkeyText}" FontFamily="Consolas" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="10,0,0,0"
                                                           Foreground="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Warning}" Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{l:T Main_Edit}" Click="EditProfile_Click" Tag="{Binding}" MinHeight="32" Padding="10,2" Margin="0,0,6,0"
                                                    AutomationProperties.Name="{Binding EditName}" />
                                            <Button Content="{l:T Main_Delete}" Click="DeleteProfile_Click" Tag="{Binding}" MinHeight="32" Padding="10,2"
                                                    AutomationProperties.Name="{Binding DeleteName}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Spalte 3: laufende Apps -->
        <Border Grid.Row="1" Grid.Column="4" Style="{StaticResource Panel}">
            <DockPanel>
                <Label DockPanel.Dock="Top" Target="{Binding ElementName=RunningList}" Padding="0" Margin="0,0,0,8">
                    <AccessText Text="{l:T Main_Running}" FontSize="16" FontWeight="SemiBold" />
                </Label>
                <TextBlock DockPanel.Dock="Top" Text="{l:T Main_RunningHint}" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8" />
                <Button DockPanel.Dock="Bottom" x:Name="AddRunningButton" Content="{l:T Main_AddToGroup}" Click="AddRunning_Click"
                        HorizontalAlignment="Stretch" MinHeight="32" Margin="0,8,0,0" />
                <ListBox x:Name="RunningList" AutomationProperties.Name="{l:T Main_RunningName}"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="RunningList_SelectionChanged"
                         PreviewMouseLeftButtonDown="RunningList_PreviewMouseLeftButtonDown" PreviewMouseMove="RunningList_PreviewMouseMove"
                         MouseDoubleClick="RunningList_MouseDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="Root" Margin="0,3" AutomationProperties.Name="{Binding AccessibleName}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Image Grid.RowSpan="2" Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding VolumeText}" FontSize="11" Opacity="0.7" Margin="8,0,0,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Exe, Mode=OneWay}" /><Run Text="{Binding InGroupSuffix, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                                <!-- Balken immer volle Spaltenbreite, Füllung = Prozentwert (eigener Balken ohne Animation) -->
                                <Grid Grid.Row="2" Grid.ColumnSpan="3" Height="4" Margin="0,4,0,0" ClipToBounds="True">
                                    <Border CornerRadius="2" Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Opacity="0.5" />
                                    <Border CornerRadius="2" Background="{DynamicResource {x:Static SystemColors.AccentColorBrushKey}}"
                                            RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding VolumeFraction, Mode=OneWay}" ScaleY="1" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsInGroup}" Value="True">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="Root" Property="Cursor" Value="No" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
