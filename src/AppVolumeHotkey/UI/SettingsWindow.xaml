<Window x:Class="AppVolumeHotkey.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AppVolumeHotkey.Localization"
        Title="{l:T Settings_Title}"
        Width="580" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- Lange Beschriftungen umbrechen statt abschneiden (Fluent-Stil bleibt erhalten) -->
        <DataTemplate x:Key="WrapContent">
            <AccessText Text="{Binding}" TextWrapping="Wrap" />
        </DataTemplate>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="ContentTemplate" Value="{StaticResource WrapContent}" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="ContentTemplate" Value="{StaticResource WrapContent}" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="20">
        <TextBlock Text="{l:T Settings_Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16" />

        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Content="{l:T Settings_Language}" Target="{Binding ElementName=LanguageBox}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" x:Name="LanguageBox" AutomationProperties.Name="{l:T Settings_LanguageA11y}" />
        </Grid>

        <TextBlock Text="{l:T Settings_Start}" FontWeight="SemiBold" Margin="0,0,0,6" />
        <CheckBox x:Name="StartWithWindowsBox" Content="{l:T Settings_StartWithWindows}" Margin="0,0,0,6" />
        <CheckBox x:Name="StartMinimizedBox" Content="{l:T Settings_StartMinimized}" Margin="0,0,0,6" />
        <CheckBox x:Name="MinimizeToTrayBox" Content="{l:T Settings_MinimizeToTray}" Margin="0,0,0,6" />
        <CheckBox x:Name="RunAsAdminBox" Content="{l:T Settings_RunAsAdmin}" />
        <TextBlock x:Name="RunAsAdminHint" Text="{l:T Settings_RunAsAdminHint}"
                   Opacity="0.75" FontSize="12" TextWrapping="Wrap" Margin="26,2,0,0" />

        <TextBlock Text="{l:T Settings_Overlay}" FontWeight="SemiBold" Margin="0,18,0,2" />
        <TextBlock Text="{l:T Settings_OverlayHint}"
                   Opacity="0.75" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Grid.Row="3" Content="{l:T Settings_Style}" Target="{Binding ElementName=StyleBox}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="3" Grid.Column="1" x:Name="StyleBox" Margin="0,6,0,0" AutomationProperties.Name="{l:T Settings_StyleA11y}" />
            <Label Grid.Row="0" Content="{l:T Settings_Position}" Target="{Binding ElementName=CornerBox}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CornerBox" Margin="0,0,0,6" AutomationProperties.Name="{l:T Settings_PositionA11y}" />
            <Label Grid.Row="1" Content="{l:T Settings_Size}" Target="{Binding ElementName=SizeBox}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="SizeBox" Margin="0,0,0,6" AutomationProperties.Name="{l:T Settings_SizeA11y}" />
            <Label Grid.Row="2" Content="{l:T Settings_Duration}" Target="{Binding ElementName=DurationBox}" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="DurationBox" AutomationProperties.Name="{l:T Settings_DurationA11y}" />
        </Grid>
        <Button Content="{l:T Settings_TestOverlay}" Click="TestOverlay_Click" HorizontalAlignment="Left" MinHeight="32" Padding="12,4" Margin="0,8,0,0" />

        <TextBlock Text="{l:T Settings_Status}" FontWeight="SemiBold" Margin="0,18,0,2" />
        <TextBlock Text="{l:T Settings_StatusHint}" Opacity="0.75" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
        <CheckBox x:Name="StatusOnBox" Content="{l:T Settings_StatusOn}" Margin="0,0,0,6" />
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="{l:T Settings_StatusStyle}" Target="{Binding ElementName=StatusStyleBox}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="StatusStyleBox" Margin="0,0,0,6" AutomationProperties.Name="{l:T Settings_StatusStyleA11y}" />
            <Label Grid.Row="1" Content="{l:T Settings_StatusCorner}" Target="{Binding ElementName=StatusCornerBox}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="StatusCornerBox" Margin="0,0,0,6" AutomationProperties.Name="{l:T Settings_StatusCornerA11y}" />
            <Label Grid.Row="2" Content="{l:T Settings_StatusOpacity}" Target="{Binding ElementName=StatusOpacityBox}" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="StatusOpacityBox" AutomationProperties.Name="{l:T Settings_StatusOpacityA11y}" />
        </Grid>
        <CheckBox x:Name="TrayBadgeBox" Content="{l:T Settings_TrayBadge}" Margin="0,4,0,0" />

        <TextBlock Text="{l:T Settings_Transition}" FontWeight="SemiBold" Margin="0,18,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Label Content="{l:T Settings_Fade}" Target="{Binding ElementName=FadeBox}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" x:Name="FadeBox" AutomationProperties.Name="{l:T Settings_FadeA11y}" />
        </Grid>

        <TextBlock x:Name="ErrorText" Margin="0,10,0,0" TextWrapping="Wrap" FontWeight="SemiBold" Visibility="Collapsed"
                   Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="{l:T Common_Save}" IsDefault="True" Click="Save_Click" MinWidth="100" MinHeight="32" Margin="0,0,8,0" />
            <Button Content="{l:T Common_Cancel}" IsCancel="True" MinWidth="100" MinHeight="32" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
